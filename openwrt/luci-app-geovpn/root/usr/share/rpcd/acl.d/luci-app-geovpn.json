{
  "luci-app-geovpn": {
    "description": "Grant access to GeoVPN",
    "read": {
      "uci": [
        "geovpn"
      ],
      "ubus": {
        "luci.geovpn": [
          "status",
          "logs",
          "profile_get",
          "geo_catalog",
          "geo_update_status",
          "test_target",
          "diag"
        ]
      }
    },
    "write": {
      "uci": [
        "geovpn"
      ],
      "ubus": {
        "luci.geovpn": [
          "import_ovpn",
          "profile_save_raw",
          "profile_set_credentials",
          "profile_put_material",
          "profile_delete",
          "service",
          "panic",
          "geo_update"
        ]
      }
    }
  },
  "luci-app-geovpn-extra": {
    "description": "Grant access to GeoVPN testing, batch import, and credentials",
    "read": {
      "uci": [
        "luci"
      ],
      "ubus": {
        "luci.geovpn": [
          "test_status",
          "test_results",
          "list_credentials",
          "autoconnect_status",
          "check_update"
        ]
      }
    },
    "write": {
      "uci": [
        "luci"
      ],
      "ubus": {
        "luci.geovpn": [
          "test_start",
          "test_cancel",
          "test_cleanup",
          "import_profile",
          "import_batch",
          "profile_add",
          "save_credential",
          "delete_credential",
          "health_tick",
          "apply_update"
        ]
      }
    }
  }
}
