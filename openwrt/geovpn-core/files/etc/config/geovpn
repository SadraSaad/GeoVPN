config main 'main'
	option config_version '1'
	option enabled '0'
	option active_profile ''
	option split_enabled '1'
	option mode 'bypass'
	option private_direct '1'
	option ipv6 'auto'
	option kill_switch '0'
	option router_traffic 'dns'
	list lan_ifs 'br-lan'
	list lan_zones 'lan'
	option tun_dev 'geovpn0'
	option mark_shift '24'
	option rt_table '4200'
	option rule_priority '700'
	option dns_mode 'follow'
	list dns_direct_servers 'auto'
	list dns_vpn_servers '1.1.1.1'
	list dns_vpn_servers '9.9.9.9'
	option dns_hijack '1'
	option block_dot '1'
	option block_doh '0'
	option dns_canary '1'
	option dyn_timeout '6h'
	option max_cidrs '150000'
	option max_domains '60000'
	option allow_large '0'
	option flush_conntrack '0'
	option log_level 'info'

config data 'data'
	option source_url 'https://geovpn.github.io/geovpn-data/v1/'
	option verify '1'
	option pack_pubkey '/etc/geovpn/keys/pack.pub'
	option auto_update '1'
	option update_cron '17 4 * * *'
	option update_via 'auto'
	option keep_prev '1'
