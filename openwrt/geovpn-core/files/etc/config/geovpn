config main 'main'
	option config_version '2'
	option enabled '0'
	option active_profile ''
	option split_enabled '1'
	option mode 'bypass'
	option private_direct '1'
	option ipv6 'auto'
	option kill_switch '0'
	option router_traffic 'dns'
	list lan_ifs 'br-lan'
	list lan_zones 'lan'
	option tun_dev 'geovpn0'
	option mark_shift '24'
	option rt_table '4200'
	option rule_priority '700'
	option dns_mode 'follow'
	list dns_direct_servers 'auto'
	list dns_vpn_servers '1.1.1.1'
	list dns_vpn_servers '9.9.9.9'
	option dns_hijack '1'
	option block_dot '1'
	option block_doh '0'
	option dns_canary '1'
	option dyn_timeout '6h'
	option max_cidrs '150000'
	option max_domains '60000'
	option allow_large '0'
	option flush_conntrack '0'
	option log_level 'info'

config data 'data'
	option source_url 'https://geovpn.github.io/geovpn-data/v1/'
	option verify '1'
	option pack_pubkey '/etc/geovpn/keys/pack.pub'
	option auto_update '1'
	option update_cron '17 4 * * *'
	option update_via 'auto'
	option keep_prev '1'

config test 'test'
	option max_handshake_ms '8000'
	option max_latency_ms '800'
	option max_loss_pct '34'
	option require_http '1'
	option samples '3'
	option timeout_s '20'
	option tolerance_ms '50'
	option test_ttl '300'
	option max_real '1'
	option min_free_ram_mb '48'
	option max_load '3.0'
	list targets 'https://www.gstatic.com/generate_204'
	list targets 'http://cp.cloudflare.com/generate_204'
	list proto_preference 'wireguard'
	list proto_preference 'openvpn'
	list proto_preference 'ikev2'
	option speed_url ''
	option speed_max_kb '2048'
	option rt_table '4300'

config autoconnect 'auto'
	option mode 'off'
	list fallback ''
	option connect_gate 'off'
	option health_enabled '0'
	option health_interval '120'
	option fail_threshold '3'
	option down_grace '30'
	option failover '0'
	option failover_max_candidates '3'
	option best_max_candidates '8'
	option failback '0'
	option min_switch_interval '60'
	option max_switches_per_hour '6'
	option persist_switch '0'
