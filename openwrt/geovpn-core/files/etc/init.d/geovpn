#!/bin/sh /etc/rc.common
#
# GeoVPN service procd init script
#
# shellcheck disable=SC2034
START=95
STOP=10
export USE_PROCD=1

EXTRA_COMMANDS="switch"
EXTRA_HELP="	switch <profile_id> [--persist]	Switch active profile"

PROG=/usr/sbin/openvpn
RUN_DIR=/var/run/geovpn

start_service() {
	# Run preflight and render rules/configs
	if ! /usr/bin/geovpn _prepare; then
		echo "GeoVPN: preparation failed, service not started." >&2
		return 1
	fi

	if [ -f "$RUN_DIR/active_override" ]; then
		ACTIVE_ID=$(cat "$RUN_DIR/active_override" | tr -d ' \t\n\r')
	else
		ACTIVE_ID=$(uci -q get geovpn.main.active_profile || true)
	fi
	if [ -z "$ACTIVE_ID" ]; then
		echo "GeoVPN: no active profile configured." >&2
		return 0
	fi

	PROTO=$(uci -q get geovpn."$ACTIVE_ID".proto || echo "openvpn")
	if [ "$PROTO" = "wireguard" ] || [ "$PROTO" = "ikev2" ]; then
		procd_open_instance "geovpn"
		procd_set_param file /etc/config/geovpn
		procd_close_instance
		return 0
	fi

	CONF_FILE="$RUN_DIR/$ACTIVE_ID.conf"
	if [ ! -f "$CONF_FILE" ]; then
		echo "GeoVPN: rendered config $CONF_FILE not found." >&2
		return 1
	fi

	procd_open_instance "geovpn"
	procd_set_param command "$PROG" --config "$CONF_FILE"
	procd_set_param respawn 3600 5 0
	procd_set_param file /etc/config/geovpn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	/usr/bin/geovpn _teardown
}

reload_service() {
	/usr/bin/geovpn _reload
}

switch() {
	/usr/bin/geovpn switch "$@"
}
