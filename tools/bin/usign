#!/bin/sh
ROOTFS="${OW_ROOTFS:-/tmp/ow-rootfs}"
if [ -x "$ROOTFS/lib/ld-musl-x86_64.so.1" ] && [ -x "$ROOTFS/usr/bin/usign" ]; then
	exec "$ROOTFS/lib/ld-musl-x86_64.so.1" --library-path "$ROOTFS/lib:$ROOTFS/usr/lib" "$ROOTFS/usr/bin/usign" "$@"
fi
if command -v usign.bin >/dev/null 2>&1; then
	exec usign.bin "$@"
fi
exit 127
